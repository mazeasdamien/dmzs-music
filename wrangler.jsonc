{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmzs-music",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Le Worker passe en premier : il doit contrôler le cookie avant
    // de servir le moindre fichier.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dmzs-music",
      // ← remplacé par `npm run setup:db`
      "database_id": "REPLACE_AFTER_CREATION"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dmzs-music"
    }
  ],

  // Pas de `containers` ni de `durable_objects` : le téléchargeur tourne sur
  // une machine perso et vient chercher le travail via /internal/next-job.
  // C'est ce qui garde le projet entièrement dans les paliers gratuits — les
  // Containers Cloudflare n'ont aucun palier gratuit — et ce qui lui donne une
  // IP résidentielle, la seule qui passe durablement le filtrage de YouTube.

  // La zone example.com doit être sur ton compte Cloudflare, avec les serveurs
  // de noms Cloudflare actifs (obligatoire pour un Worker, contrairement à
  // Pages). `custom_domain` crée l'enregistrement DNS du sous-domaine tout seul.
  "routes": [{ "pattern": "music.example.com", "custom_domain": true }],

  "vars": {
    // Doit correspondre au domaine public : le conteneur rappelle le Worker
    // à cette adresse une fois le téléchargement terminé.
    "APP_URL": "https://music.example.com"
  },

  "observability": { "enabled": true }
}
