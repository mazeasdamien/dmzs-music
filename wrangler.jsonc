{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmzs-music",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first: it has to check the cookie before serving
    // any file at all.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dmzs-music",
      // <- replaced by `npm run setup:db`
      "database_id": "REPLACE_AFTER_CREATION"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dmzs-music"
    }
  ],

  // No `containers` and no `durable_objects`: the downloader runs on a
  // personal machine and pulls work from /internal/next-job.
  //
  // Not for the cost. A Workers Paid plan includes a container allowance that
  // a library this size never comes close to spending. The reason is the
  // address the request leaves from. A container egresses through Cloudflare's
  // ranges, and datacenter ranges are classified as such by YouTube's bot
  // filtering long before your first request arrives; a residential
  // connection is the only kind that keeps working over time. So the machine
  // that fetches has to be one, which also means it has to be yours.

  // The zone must be on your Cloudflare account, with Cloudflare nameservers
  // active (required for a Worker, unlike Pages). `custom_domain` creates the
  // subdomain's DNS record on its own.
  "routes": [{ "pattern": "music.example.com", "custom_domain": true }],

  "triggers": {
    // Podcast upkeep: re-read subscribed feeds (each feed at most once an
    // hour) and drain the episode queue those refreshes fill. Every 20
    // minutes rather than hourly: a pass that fails is retried soon instead
    // of next hour, and a pass refreshes only five feeds, so the cadence is
    // what keeps a longer subscription list coming round often enough.
    "crons": ["*/20 * * * *"]
  },

  "vars": {
    // Must match the public domain: the downloader calls the Worker back at
    // this address once a download is finished.
    "APP_URL": "https://music.example.com"
  },

  "observability": { "enabled": true }
}
